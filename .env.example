# Set to your existing Sub2API HTTPS origin, with no path. No built-in default.
GEEKPULSE_PUBLIC_ORIGIN=
# Port where Sub2API is reachable on 127.0.0.1 from the GeekPulse host.
GEEKPULSE_SUB2API_PORT=8080
# Optional branding; both image references use one same-origin asset.
GEEKPULSE_SITE_NAME=GeekPulse
GEEKPULSE_LOGO_PATH=/model-lab/pulse.svg
# Browser storage prefix for pending requests.
GEEKPULSE_RECEIPT_NAMESPACE=geekpulse-lab
