[Unit]
Description=GeekPulse release updater
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/geekpulse-updater/update_agent.py
EnvironmentFile=-/etc/geekpulse/updater.env
RuntimeDirectory=geekpulse-updater
RuntimeDirectoryMode=0755
StateDirectory=geekpulse-updater
StateDirectoryMode=0755
UMask=0022
Restart=on-failure
RestartSec=10
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/opt/geekpulse
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_CHOWN
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
